<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS (Pleos Connect) 앱 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK: 기어 조회(Get)만 사용. 제어 권한은 쓰지 않는다 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Pleos TextToSpeech / SpeechToText SDK -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- Pleos NaviHelper SDK: get*Info() 조회만 사용 (경로 탐색·변경 권한은 쓰지 않는다) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 중계 예약·중계 중에만 다른 앱(내비 등)을 보고 있어도 효과음이 이어지도록 유지.
         부팅 자동 시작은 하지 않는다 (Pleos '미사용 앱 BG→CCH 전환 가이드') -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 시스템 TTS 대체 경로(Pleos TTS 서비스가 없는 기기) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RoadiumApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ROADIUM"
        tools:targetApi="34">

        <!-- 주행 규제(CarUxRestrictions) 조회. 없는 기기에서는 기어 기준 잠금만 쓴다 -->
        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에는 스코어보드·이벤트 카드·큰 버튼만 남기고, 규제 상태를 직접 반영한다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".service.BroadcastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="While the user has reserved or started a live sports relay, waits for game events and plays short sound effects and voice announcements while the driver uses other apps such as navigation" />
        </service>
    </application>

</manifest>
